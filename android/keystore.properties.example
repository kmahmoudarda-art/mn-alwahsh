# Copy this file to keystore.properties (same folder) and fill in the real
# values. keystore.properties is gitignored — never commit real passwords.
#
# storeFile is relative to the android/app/ module, so ../../signing.keystore
# points at the keystore.keystore file kept at the repo root next to this
# android/ folder. Move signing.keystore there before building, or change
# this path to wherever you put it.
storeFile=../../signing.keystore
storePassword=
keyAlias=my-key-alias
keyPassword=
